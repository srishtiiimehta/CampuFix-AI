{
  "entities": {
    "Ticket": {
      "title": "Maintenance Ticket",
      "description": "Structured university campus facility maintenance ticket generated by Gemini AI with strict category and status validation",
      "type": "object",
      "properties": {
        "ticketId": {
          "type": "string",
          "description": "Unique server-generated ticket identifier"
        },
        "reporterId": {
          "type": "string",
          "description": "Student or reporter identifier"
        },
        "reporterName": {
          "type": "string",
          "description": "Name of the reporting student"
        },
        "reporterRole": {
          "type": "string",
          "enum": ["student", "staff"],
          "description": "Role of reporter"
        },
        "category": {
          "type": "string",
          "enum": ["Plumbing", "Electricity", "Cleanliness", "Internet Connectivity"],
          "description": "One of four strictly allowed university facility categories"
        },
        "assignedDepartment": {
          "type": "string",
          "enum": [
            "Plumbing / Water Maintenance",
            "Electrical Maintenance",
            "Housekeeping / Sanitation",
            "IT / Network Support"
          ],
          "description": "Department strictly mapped from the category"
        },
        "issueSummary": {
          "type": "string",
          "minLength": 5,
          "maxLength": 500,
          "description": "Concise summary of the problem"
        },
        "reportedLocation": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "description": "Campus building and room or specific area"
        },
        "reportedTime": {
          "type": "string",
          "description": "ISO timestamp when reported"
        },
        "priority": {
          "type": "string",
          "enum": ["Low", "Medium", "High", "Critical"]
        },
        "status": {
          "type": "string",
          "enum": ["Open", "In Progress", "Resolved"]
        },
        "createdAt": {
          "type": "string",
          "description": "Server timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "Server timestamp of last update"
        },
        "trackedBy": {
          "type": "array",
          "description": "Student userIds authorized to track this ticket"
        },
        "associatedReportCount": {
          "type": "number",
          "description": "Total number of student complaints consolidated into this issue"
        },
        "relatedTicketId": {
          "type": "string",
          "description": "Linked duplicate or reference ticket ID"
        },
        "resolutionNotes": {
          "type": "string",
          "maxLength": 1000,
          "description": "Staff mandatory notes prior to marking as Resolved"
        }
      },
      "required": ["ticketId", "category", "assignedDepartment", "issueSummary", "reportedLocation", "status", "createdAt", "updatedAt"]
    },
    "DuplicateAssociation": {
      "title": "Duplicate Report Association",
      "description": "Persistent record linking a student report to an existing ticket or recording a separate submission decision",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ticketId": { "type": "string" },
        "reporterId": { "type": "string" },
        "reporterName": { "type": "string" },
        "decision": { "type": "string", "enum": ["tracked_existing", "separate_issue"] },
        "candidateSummary": { "type": "string" },
        "candidateLocation": { "type": "string" },
        "candidateCategory": { "type": "string" },
        "createdAt": { "type": "string" },
        "separateTicketId": { "type": "string" }
      },
      "required": ["id", "ticketId", "reporterId", "decision", "createdAt"]
    },
    "CampusUser": {
      "title": "Campus User Account",
      "description": "Authorized campus identity with role-based access control",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "staff"] },
        "affiliation": { "type": "string" },
        "department": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "CampusDepartment": {
      "title": "Facilities Department",
      "description": "Authorized maintenance department handling work orders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "leadName": { "type": "string" },
        "contactEmail": { "type": "string" },
        "emergencyPhone": { "type": "string" },
        "activeTechnicians": { "type": "number" },
        "targetSlaHours": { "type": "number" }
      },
      "required": ["id", "name", "category", "leadName"]
    }
  },
  "firestore": {
    "/tickets/{ticketId}": {
      "schema": "Ticket",
      "description": "Collection of all campus maintenance work orders"
    },
    "/duplicateAssociations/{associationId}": {
      "schema": "DuplicateAssociation",
      "description": "Collection of duplicate tracking and separate issue decisions"
    },
    "/users/{userId}": {
      "schema": "CampusUser",
      "description": "Directory of student and facility staff profiles"
    },
    "/departments/{departmentId}": {
      "schema": "CampusDepartment",
      "description": "Official campus facility maintenance departments"
    }
  }
}
