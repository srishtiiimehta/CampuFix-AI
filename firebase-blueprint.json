{
  "entities": {
    "Ticket": {
      "title": "Maintenance Ticket",
      "description": "Structured university campus facility maintenance ticket generated by Gemini AI",
      "type": "object",
      "properties": {
        "ticketId": {
          "type": "string",
          "description": "Unique ticket identifier"
        },
        "reporterId": {
          "type": "string",
          "description": "Student or reporter identifier"
        },
        "reporterName": {
          "type": "string",
          "description": "Name of the reporting student"
        },
        "category": {
          "type": "string",
          "enum": ["Plumbing", "Electricity", "Cleanliness", "Internet Connectivity"],
          "description": "One of four strictly allowed university facility categories"
        },
        "assignedDepartment": {
          "type": "string",
          "enum": [
            "Plumbing / Water Maintenance",
            "Electrical Maintenance",
            "Housekeeping / Sanitation",
            "IT / Network Support"
          ],
          "description": "Department strictly mapped from the category"
        },
        "issueSummary": {
          "type": "string",
          "maxLength": 300,
          "description": "Concise summary of the problem"
        },
        "reportedLocation": {
          "type": "string",
          "maxLength": 200,
          "description": "Campus building and room or specific area"
        },
        "reportedTime": {
          "type": "string",
          "description": "ISO timestamp when reported"
        },
        "priority": {
          "type": "string",
          "enum": ["Low", "Medium", "High", "Critical"]
        },
        "status": {
          "type": "string",
          "enum": ["Open", "In Progress", "Resolved"]
        },
        "resolutionNotes": {
          "type": "string",
          "maxLength": 1000,
          "description": "Staff mandatory notes prior to marking as Resolved"
        }
      },
      "required": ["ticketId", "category", "assignedDepartment", "issueSummary", "reportedLocation", "status"]
    }
  },
  "firestore": {
    "/tickets/{ticketId}": {
      "schema": "Ticket",
      "description": "Collection of all campus maintenance tickets"
    }
  }
}
